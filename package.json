{
  "name": "Nana Fox 2.0",
  "version": "1.0.0",
  "description": "Um navegador de internet baseado no Chromium",
  "author": "nana <nanadev@gmail.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.nanafox2.0.nanafox2.0",
    "productName": "Nana Fox 2.0",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "maintainer": "nana <nanadev@gmail.com>"
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
